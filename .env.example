# Copy to .env and fill in.

# Required: your OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Model ---
# Any chat model your key can reach. Change this if you get a 404 on startup.
OPENAI_MODEL=gpt-4o-mini
# Leave blank to omit the parameter entirely (reasoning models reject it).
OPENAI_TEMPERATURE=0.4
# Optional: point at Azure OpenAI or an OpenAI-compatible gateway — e.g. Groq,
# to run the chat model at $0 too: OPENAI_BASE_URL=https://api.groq.com/openai/v1
# and OPENAI_MODEL=llama-3.3-70b-versatile, with OPENAI_API_KEY set to a Groq key.
# OPENAI_BASE_URL=

# --- Speech to text ---
# Primary: Groq's hosted Whisper — free tier, multilingual (English + Hindi),
# offloads transcription off this process. Get a key at console.groq.com.
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Fallback (also used if STT_PROVIDER=local, or Groq errors/rate-limits):
# local faster-whisper. Must be a multilingual model (no ".en" suffix) since
# this app answers in Hindi too.
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# --- Text to speech ---
# Self-hosted Piper — free at any call volume. Voices download automatically
# on first use. Set to false to fall back to the browser's own voice.
TTS_ENABLED=true
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_HI=hi_IN-rohan-medium

# --- Business identity ---
BUSINESS_NAME=Spice Route Kitchen
# Real IANA zone — used for every reservation time and "today" boundary.
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_TIMEZONE_LABEL=IST
RECEPTIONIST_NAME=Meera
GREETING=Thanks for calling Spice Route Kitchen, this is Meera — how can I help you today? Aap Hindi mein bhi baat kar sakte hain.

# --- Admin dashboard / API auth ---
# Required once this is deployed off 127.0.0.1 — leave blank only for local dev.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Server ---
HOST=127.0.0.1
PORT=8000
