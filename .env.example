# Copy to .env and fill in.

# Required: your OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Model ---
# Any chat model your key can reach. Change this if you get a 404 on startup.
OPENAI_MODEL=gpt-4o
# Leave blank to omit the parameter entirely (reasoning models reject it).
OPENAI_TEMPERATURE=0.4
# Optional: point at Azure OpenAI or an OpenAI-compatible gateway.
# OPENAI_BASE_URL=

# --- Speech to text (local faster-whisper — no API key needed) ---
# tiny.en | base.en | small.en | medium.en  — larger = more accurate, slower.
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# --- Business identity (used in the system prompt and booking rules) ---
BUSINESS_NAME=Northgate Dental
BUSINESS_TIMEZONE_LABEL=local time
RECEPTIONIST_NAME=Ava
GREETING=Thanks for calling Northgate Dental, this is Ava. How can I help you today?

# Booking window, 24h clock. Days: 0=Monday .. 6=Sunday
OPEN_HOUR=9
CLOSE_HOUR=17
OPEN_DAYS=0,1,2,3,4
SLOT_MINUTES=30

# --- Server ---
HOST=127.0.0.1
PORT=8000
